# Copy to android/secret.properties (gitignored). Values are base64 SHA-1 signature hashes.
# Debug (per machine):
#   keytool -exportcert -alias androiddebugkey -keystore ~/.android/debug.keystore -storepass android -keypass android | openssl sha1 -binary | openssl base64
# Each debug hash must be registered on the Entra app registration as msauth://com.kammcs.boardhop/<url-encoded hash>.
MSAL_DEBUG_SIGNATURE_HASH=
# Release = the Google Play install. Play App Signing re-signs every upload
# with Google's app signing key, so this is the hash of THAT certificate
# (Play Console -> Test and release -> App integrity -> App signing key
# certificate, SHA-1 -> base64; or apksigner --print-certs on a Play-installed
# base.apk), not the upload key's. tool/ship-android.sh also passes it to Dart
# as BOARDHOP_ANDROID_REDIRECT_URI so both halves agree. A side-loaded
# `flutter build apk --release` carries the upload key and cannot sign in;
# use debug or profile builds for local checks. Falls back to the debug hash
# when unset.
MSAL_RELEASE_SIGNATURE_HASH=

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash icon: the artwork sits in the middle third of
     the splash image, so the circular mask shows it whole on the gradient. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground android:drawable="@drawable/splash_icon_fg" />
</adaptive-icon>

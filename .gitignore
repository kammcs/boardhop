# Raw spike outputs contain client org data (PR titles, repo names, emails).
# The consolidated findings in research/spikes/results/README.md are committed; raw files are not.
research/spikes/results/*
!research/spikes/results/README.md

# Local environment and secrets
.env
.env.*
*.pem
*.p8
*.p12
*.jks

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
*.ipr
*.iws
.flutter-plugins
.flutter-plugins-dependencies
coverage/
*.log
*.orig.*

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/key.properties
android/secret.properties
android/app/*.keystore
android/**/GeneratedPluginRegistrant.java
android/.cxx/

# iOS
ios/Pods/
ios/Podfile.lock
ios/.symlinks/
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
**/xcuserdata/
**/.swiftpm/
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.perspectivev3
ios/**/*.pbxuser
ios/**/DerivedData/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python spike scratch
__pycache__/
*.pyc

# Emulator screenshots from tool/shot.sh
.shots/

# Relay (relay/ is the push relay's home; its secrets live on the server)
relay/.env
relay/build/
relay/.dart_tool/

# App Store Connect API keys (never commit)
AuthKey_*.p8
*.p8

# Firebase (FCM) config and any push credentials: machine-local, never committed.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
*.p8
fcm-service-account*.json

# Kotlin compiler session data written by the Android Gradle build
android/.kotlin/

# Hook secrets written by relay/tool/hooks.dart (plaintext, per org)
.hooks-secret-*

# Marketplace extension (extension/ is the Azure DevOps extension's home)
extension/node_modules/
extension/dist/
extension/dist-test/
extension/build/
*.vsix

# Android release: upload keystore, its passwords and the Play Developer API service account (never committed)
android/keystore/
android/keystore.properties
*.jks
*.keystore
**/play-service-account*.json
/android/fastlane/report.xml

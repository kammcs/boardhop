# Raw spike outputs contain client org data (PR titles, repo names, emails).
# The consolidated findings in research/spikes/results/README.md are committed; raw files are not.
research/spikes/results/*
!research/spikes/results/README.md

# Local environment and secrets
.env
.env.*
*.pem
*.p8
*.p12
*.jks

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
*.ipr
*.iws
.flutter-plugins
.flutter-plugins-dependencies
coverage/
*.log
*.orig.*

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/key.properties
android/secret.properties
android/app/*.keystore
android/**/GeneratedPluginRegistrant.java
android/.cxx/

# iOS
ios/Pods/
ios/Podfile.lock
ios/.symlinks/
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
ios/**/xcuserdata/
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.perspectivev3
ios/**/*.pbxuser
ios/**/DerivedData/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

